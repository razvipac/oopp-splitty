<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>


<AnchorPane onKeyPressed="#onGlobalKeyPress" prefHeight="300.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.scenes.InvitationsCtrl">
   <children>
      <VBox alignment="CENTER" layoutX="139.0" layoutY="64.0" prefHeight="400.0" prefWidth="600.0" spacing="10.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <Label fx:id="eventTitleLabel" text="Event Title">
               <font>
                  <Font size="20.0" />
               </font>
            </Label>
            <HBox alignment="CENTER">
               <children>
                  <Label text="Give people the following Invite Code: " />
                  <Label fx:id="eventCodeLabel" text="&lt;eventCode&gt;" onMouseClicked="#handleCopyEventCode">
                     <font>
                        <Font size="14.0" />
                     </font>
                  </Label>
               </children>
            </HBox>
            <Label text="Invite the following people by email (one address per line)" />
            <TextArea fx:id="emailAddressesTextArea" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="100.0" prefWidth="400.0" />
            <Button mnemonicParsing="false" onAction="#sendInvites" text="Send Invite" />
            <Button mnemonicParsing="false" onAction="#goBack" text="Cancel" />
         </children>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
      </VBox>
   </children>
</AnchorPane>
