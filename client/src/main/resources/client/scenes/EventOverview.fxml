<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane onKeyPressed="#onGlobalKeyPress" prefHeight="500.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.scenes.EventOverviewCtrl">
   <children>
      <VBox layoutX="160.0" layoutY="36.0" prefHeight="400.0" prefWidth="600.0" spacing="10.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <VBox alignment="CENTER">
                     <children>
                        <Label fx:id="eventTitleLabel" text="Event Title">
                           <font>
                              <Font size="20.0" />
                           </font>
                        </Label>
                        <Label fx:id="eventCodeLabel" text="event code">
                           <font>
                              <Font name="System Italic" size="13.0" />
                           </font>
                        </Label>
                     </children>
                  </VBox>
                  <Button mnemonicParsing="false" text="Send Invite" />
               </children>
            </HBox>
            <VBox spacing="10.0" style="-fx-border-style: solid; -fx-border-color: #666666;">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <Label text="Participants">
                           <font>
                              <Font size="16.0" />
                           </font>
                        </Label>
                        <Button mnemonicParsing="false" text="Add/Edit Participant" />
                     </children>
                  </HBox>
                  <HBox fx:id="participantsHBox" alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <Label text="John" />
                        <Label text="Allie" />
                     </children>
                  </HBox>
               </children>
               <padding>
                  <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
               </padding>
            </VBox>
            <VBox spacing="10.0" style="-fx-border-style: solid; -fx-border-color: #666666;" VBox.vgrow="ALWAYS">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <Label text="Expenses">
                           <font>
                              <Font size="16.0" />
                           </font>
                        </Label>
                        <Button mnemonicParsing="false" text="Add Expense" />
                     </children>
                  </HBox>
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <ComboBox fx:id="expenseFilterComboBox" prefWidth="150.0" />
                        <RadioButton fx:id="expenseFilterAllRadio" mnemonicParsing="false" selected="true" text="All">
                           <toggleGroup>
                              <ToggleGroup fx:id="expenseFilterToggleGroup" />
                           </toggleGroup>
                        </RadioButton>
                        <RadioButton fx:id="expenseFilterFromRadio" mnemonicParsing="false" text="From x" toggleGroup="$expenseFilterToggleGroup" />
                        <RadioButton fx:id="expenseFilterIncludingRadio" mnemonicParsing="false" text="Including x" toggleGroup="$expenseFilterToggleGroup" />
                     </children>
                  </HBox>
                  <ScrollPane prefHeight="200.0" prefWidth="200.0">
                     <content>
                        <VBox fx:id="expenseItemContainer" />
                     </content>
                  </ScrollPane>
                  <Button mnemonicParsing="false" text="Settle Debts" />
               </children>
               <padding>
                  <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
               </padding>
            </VBox>
            <Button mnemonicParsing="false" onAction="#goBack" text="Back" />
         </children>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
      </VBox>
   </children>
</AnchorPane>
